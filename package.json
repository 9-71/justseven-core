{
  "name": "justseven-core",
  "version": "0.1.0",
  "description": "Pure-TypeScript nutritional-intelligence engine: BMR (Mifflin-St Jeor), HFS dual-constraint portion recommendation, and Bayesian/Kalman incremental personal calibration.",
  "license": "CC-BY-NC-4.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "ts-node examples/simulation_demo.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nutrition",
    "bmr",
    "hfs",
    "bayesian",
    "kalman",
    "calorie",
    "portion"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
